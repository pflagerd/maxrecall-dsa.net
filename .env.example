# Copy this file to .env (which is gitignored), next to server.js, and fill it in.
#
# - The server reads .env only when it starts. After editing, restart it
#   (Ctrl-C, then make dev); nodemon doesn't watch .env.
# - Anything already set in your shell wins over this file
#   (check with: printenv MAXRECALL_USER).
# - Values are trimmed, and an unquoted # starts a comment. If a value
#   contains # or starts or ends with a space, put it in single quotes:
#   NAME='abc#def'

# Who you are on the trusted port (TRUSTED_PORT, below).
MAXRECALL_USER=daniel.pflager@gmail.com

# Registering needs an invite: run `make invite EMAIL=you@example.com`, then
# use the code it prints on the login page's Register form. (Until
# 2026-11-04 it needed MAXRECALL_PASSWORD here instead; that's no longer
# used, and the server says so at startup if it's still set.)

# Optional: allow Run and Submit even when the judge's sandbox (bubblewrap)
# is missing or fails its startup check. Without this the server refuses to
# judge in that case. It never turns a working sandbox off. For setting up
# your own machine only; never on a server others use.
#MAXRECALL_UNSANDBOXED=1

# Optional: a second listener on 127.0.0.1 only, where everyone is MAXRECALL_USER
# with no sign-in. For an SSH tunnel on a server; leave unset on your own machine.
#TRUSTED_PORT=3001

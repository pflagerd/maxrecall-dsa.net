# systemd service for running MaxRecall DSA on the VPS.
# Install and use it by following docs/deploy-vps.md.
#
# Paths assume the layout in that guide:
#   /srv/maxrecall/maxrecall-dsa.net   the git checkout (read-only to the service)
#   /srv/maxrecall/data/users          saved submissions (outside the checkout)
#   /srv/maxrecall/data/auth           accounts and sessions (created at startup)
#   /usr/local/bin/node                Node 22 from nodejs.org

[Unit]
Description=MaxRecall DSA practice server
Documentation=https://github.com/pflagerd/maxrecall-dsa.net/blob/master/docs/deploy-vps.md
After=network.target

[Service]
Type=simple
User=maxrecall
Group=maxrecall
WorkingDirectory=/srv/maxrecall/maxrecall-dsa.net
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=2

# Only reachable from this machine. Port 3000 requires sign-in; the SSH
# tunnel connects to the trusted port, 3001, where you are MAXRECALL_USER
# with no sign-in. Never point anything else (e.g. a reverse proxy) at 3001.
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=TRUSTED_PORT=3001
Environment=MAXRECALL_USER=daniel.pflager@gmail.com
Environment=MAXRECALL_USERS_DIR=/srv/maxrecall/data/users
Environment=MAXRECALL_AUTH_DIR=/srv/maxrecall/data/auth
# No secrets: registering needs an invite from `make invite` (docs/plans/
# limited-live.md, step 1). Until 2026-11-04 an EnvironmentFile here,
# /etc/maxrecall-dsa/test.env, gave the server MAXRECALL_PASSWORD; that file
# can be deleted.

# --- Containment -----------------------------------------------------------
# An outer layer around the judge's own sandbox (bubblewrap, judge/
# sandbox.js), which compiles and runs every submission: these limit what
# the server, and anything that got out of a sandbox, can do.
# See systemd.exec(5) and systemd.resource-control(5).

# No network except this machine itself: the server only needs to answer the
# tunnel, so submitted code can't reach the internet either.
IPAddressDeny=any
IPAddressAllow=localhost

# The whole file system is read-only except these: saved submissions, and
# the two folders where the judge compiles its helpers at startup.
ProtectSystem=strict
ReadWritePaths=/srv/maxrecall/data /srv/maxrecall/maxrecall-dsa.net/judge/cpp /srv/maxrecall/maxrecall-dsa.net/judge/java
ProtectHome=yes
# A private /tmp (the judge writes its temporary files there).
PrivateTmp=yes
PrivateDevices=yes

NoNewPrivileges=yes
RestrictSUIDSGID=yes
# Not ProtectKernelTunables (owner's decision, 2026-11-02): it mounts over
# parts of /proc (/proc/sys, /proc/kcore, /proc/kallsyms, ...), and the
# kernel then refuses the fresh /proc each bubblewrap sandbox mounts ("Mount
# too revealing", fs/namespace.c, mnt_already_visible). On the VPS the
# sandbox failed with "bwrap: Can't mount proc on /newroot/proc: Operation
# not permitted"; a systemd-run test with every setting below and above
# worked once ProtectKernelTunables=yes alone was left out. This service runs
# as an unprivileged user with NoNewPrivileges, so it can't write kernel
# tunables anyway, and submissions get their own /proc inside the sandbox.
ProtectKernelModules=yes
LockPersonality=yes
# Not MemoryDenyWriteExecute: Node's and Java's JIT compilers need it off.

# --- cgroup limits per submission (sandboxing step 7) -----------------------
# systemd hands this unit's cgroup over to the service (Delegate=) and starts
# the server in a "server" subgroup of it (DelegateSubgroup=, systemd 254 or
# later). The server then gives each submission a cgroup of its own next to
# it, capping memory, processes and CPU for the whole submission
# (judge/cgroups.js). MAXRECALL_REQUIRE_CGROUPS=1 makes the server refuse to
# judge if it can't (owner's decision, 2026-11-02).
Delegate=yes
DelegateSubgroup=server
Environment=MAXRECALL_REQUIRE_CGROUPS=1
# Not ProtectControlGroups (owner's decision, 2026-11-02): it makes
# /sys/fs/cgroup read-only for the whole unit, delegated subtree included,
# so the server couldn't create submission cgroups. Tested on the VPS with
# systemd-run as maxrecall: with ProtectControlGroups=yes, writing the
# unit's cgroup.subtree_control failed with "Read-only file system"; without
# it, a judge-test cgroup with its own memory.max worked. The "private"
# variant (a private writable view) needs a newer systemd than 24.04's 255
# ("Failed to parse ProtectControlGroups: private"). Outside its own
# delegated subtree, the cgroup tree belongs to root, so the service still
# can't change it (tested: "Permission denied"), and the sandbox doesn't
# mount /sys at all.

[Install]
WantedBy=multi-user.target

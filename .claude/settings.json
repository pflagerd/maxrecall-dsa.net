{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make typecheck)",
      "Bash(make doc-check)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
